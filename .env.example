# ══════════════════════════════════════════════════════════
#  IA_Infraestructura — Variables de Entorno (Ejemplo)
#  Copia este archivo como .env en la raíz de cada servicio
#  o configura las variables correspondientes.
# ══════════════════════════════════════════════════════════

# ─── Puertos (rango reservado 3000-3799) ─────────────────
PORT=3000
GITHUB_SERVICE_PORT=3100
FIREBASE_SERVICE_PORT=3200
PROJECT_CREATOR_PORT=3300
DOMAIN_MANAGER_PORT=3400
DESIGN_ASSETS_PORT=3500
RAG_SERVICE_PORT=3600
SCRAPING_SERVICE_PORT=3700

# ─── GitHub (infra-github) ───────────────────────────────
# Token personal de acceso de GitHub (requiere permisos para issues, repos y pull requests)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tu-usuario
GITHUB_REPO=tu-repositorio
GITHUB_BRANCH=main
GITHUB_POSTS_PATH=posts

# ─── Firebase (infra-firebase) ───────────────────────────
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project.iam.gserviceaccount.com
# Asegúrate de escribir saltos de línea (\n) literales si lo pasas en una sola línea
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: ruta absoluta o relativa al JSON de la service account key
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# ─── Cloudflare (infra-domain-manager) ───────────────────
CLOUDFLARE_API_TOKEN=tu_cloudflare_api_token
CLOUDFLARE_ZONE_ID=tu_zone_id
CLOUDFLARE_ACCOUNT_ID=tu_account_id
CLOUDFLARE_BASE_DOMAIN=tu-dominio.com

# ─── Project Creator (infra-project-creator) ─────────────
# Carpeta donde se creará el scaffolding de nuevos proyectos
BASE_PROYECTOS_DIR=C:\ruta\a\tu\carpeta\de\proyectos
