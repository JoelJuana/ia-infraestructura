{
  "name": "infra-github",
  "version": "1.0.0",
  "description": "CMS web para publicar y gestionar archivos Markdown directamente en un repositorio de GitHub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "github",
    "cms",
    "markdown",
    "publisher"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "markdownlint": "^0.34.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}