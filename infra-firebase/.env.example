# Configuración de Firebase para Firbase Automation Service
# Opción A: Variables individuales de la Service Account
FIREBASE_PROJECT_ID=proyectos-ia-4fa3f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@proyectos-ia-4fa3f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...tu_clave_privada...\n-----END PRIVATE KEY-----\n"

# Opción B: Ruta al archivo JSON de Service Account (tiene prioridad sobre Opción A)
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# Opción C: Token de CI/CD de Firebase (solo para despliegues de Hosting)
# FIREBASE_TOKEN=1//0xxxxxxxxxxxxxxxxxxxx

# Puerto del servidor (por defecto 4001)
PORT=4001
